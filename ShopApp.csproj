<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- MySQL provider for EF Core (brings EF Core itself) -->
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <!-- Only needed if you later want "dotnet ef migrations" -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Admin files live outside wwwroot so they are never served publicly -->
    <None Include="Private\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
